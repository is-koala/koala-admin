# Kopyalayın: cp .env.example .env.local
#
# Buradaki hiçbir değişken NEXT_PUBLIC_ ile başlamaz ve başlamamalıdır.
# Tarayıcı Koala backend'ine hiç doğrudan konuşmaz; her istek Next.js
# sunucusundan geçer, dolayısıyla tarayıcının API adresini bilmesine de gerek
# yoktur. Değerler src/env.ts içinde zod ile açılışta doğrulanır: eksik ya da
# bozuk bir değişkenle uygulama yarım açılmaz, hiç açılmaz.

# Koala backend'inin kökü. Backend'de servlet context-path yoktur; uçlar kökten
# servis edilir (/reference/job-categories gibi).
#   Yerel:  http://localhost:8080
#   Canlı:  https://api.iskoala.com
#
# Yerelde backend ayağa kaldırmadan çalışmak isterseniz staging'e de
# bakabilirsiniz: https://api-staging.iskoala.com
KOALA_API_BASE_URL=http://localhost:8080

# Tek bir backend çağrısı için üst sınır (milisaniye). Opsiyoneldir; varsayılan 15000.
# KOALA_API_TIMEOUT_MS=15000

# --- Personel oturumu (is-koala/koala-admin#4) ---

# Panelin kendi dış adresi. Auth.js redirect_uri'yi ve çıkıştan sonraki dönüş
# adresini buradan kurar; Keycloak client'ındaki listeyle birebir aynı olmalı,
# yoksa Keycloak sebebini söylemeden `invalid_redirect_uri` der.
#   Yerel:  http://localhost:3000
#   Canlı:  https://admin.iskoala.com
# localhost dışında https zorunludur (src/env.ts doğrular).
AUTH_URL=http://localhost:3000

# Oturum çerezini şifreleyen anahtar — çerez imzalı değil, şifrelidir.
#   openssl rand -base64 32
# Gerçek bir sırdır: bu değeri bilen çerezin içindeki Keycloak token'larını okur.
AUTH_SECRET=

# Realm'in issuer'ı (docs/keycloak-setup.md §7).
#   Canlı:  https://auth.iskoala.com/realms/koala-staff
#   Yerel:  http://localhost:8085/realms/koala-staff  (docs/local-keycloak.md)
KEYCLOAK_ISSUER=http://localhost:8085/realms/koala-staff

KEYCLOAK_CLIENT_ID=koala-admin-web

# Confidential client'ın secret'ı. Yalnız sunucu ortam değişkeni olarak durur:
# hiçbir NEXT_PUBLIC_* değişkenine, hiçbir tarayıcı paketine ve hiçbir izlenen
# dosyaya girmez. Yerel Keycloak'ın atılabilir değeri docs/local-keycloak.md'de.
KEYCLOAK_CLIENT_SECRET=

# Access token'ın taşıması gereken audience (docs/keycloak-setup.md §4).
# Opsiyoneldir; varsayılan koala-api.
# KOALA_API_AUDIENCE=koala-api
