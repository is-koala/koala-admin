# Kopyalayın: cp .env.example .env.local
#
# Buradaki hiçbir değişken NEXT_PUBLIC_ ile başlamaz ve başlamamalıdır.
# Tarayıcı Koala backend'ine hiç doğrudan konuşmaz; her istek Next.js
# sunucusundan geçer, dolayısıyla tarayıcının API adresini bilmesine de gerek
# yoktur. Değerler src/env.ts içinde zod ile açılışta doğrulanır: eksik ya da
# bozuk bir değişkenle uygulama yarım açılmaz, hiç açılmaz.

# Koala backend'inin kökü. Backend'de servlet context-path yoktur; uçlar kökten
# servis edilir (/reference/job-categories gibi).
#   Yerel:  http://localhost:8080
#   Canlı:  https://api.iskoala.com
#
# Yerelde backend ayağa kaldırmadan çalışmak isterseniz staging'e de
# bakabilirsiniz: https://api-staging.iskoala.com
KOALA_API_BASE_URL=http://localhost:8080

# Tek bir backend çağrısı için üst sınır (milisaniye). Opsiyoneldir; varsayılan 15000.
# KOALA_API_TIMEOUT_MS=15000

# Backend kanıt indirme ucunun döndürebileceği kısa ömürlü imzalı URL'lerin
# origin allowlist'i. BFF bu adresi tarayıcıya vermez; dosyayı sunucudan alıp
# same-origin yanıt olarak akıtır. Birden fazlasını virgülle ayırın. Yalnız
# HTTPS origin (yerel geliştirmede loopback HTTP) kabul edilir; path/query yoktur.
# Boş değer fail-closed'dur ve yerel depolamanın doğrudan 200 stream akışını
# etkilemez.
EVIDENCE_DOWNLOAD_ALLOWED_ORIGINS=

# --- Personel oturumu (ADR-0014) ---

# Panelin kendi dış adresi. Tek işi var ve önemsiz değil: oturum çerezinin
# `Secure` işaretlenip işaretlenmeyeceğini bu belirler. `Secure` bir çerez düz
# HTTP üzerinde tarayıcı tarafından hiç saklanmaz, yani yanlış bir değer sessizce
# "kimse giriş yapamıyor" olarak görünür.
#   Yerel:  http://localhost:3000
#   Canlı:  https://admin.iskoala.com
# localhost dışında https zorunludur (src/env.ts doğrular).
ADMIN_PUBLIC_ORIGIN=http://localhost:3000

# Panelin başka bir sırra ihtiyacı yok.
#
# Kimlik doğrulama Koala'nın kendi JWT'siyle yapılır (ADR-0014): personel
# e-posta ve parolasını panele yazar, panel POST /admin/auth/login'e gider ve
# dönen token'ları HttpOnly bir çerezde tutar. Çerez şifrelenmiyor, çünkü içeriği
# zaten kimlik bilgisinin kendisi — onu yanı başında duran bir anahtarla
# şifrelemek yeni bir sır eklemekten başka bir şey yapmazdı.
#
# İlk OWNER hesabı backend'in BOOTSTRAP_OWNER_* değişkenleriyle doğar; o sır
# koala-backend'in .env'ine aittir, buraya değil.
