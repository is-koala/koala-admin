# Kopyalayın: cp .env.example .env.local
#
# Buradaki hiçbir değişken NEXT_PUBLIC_ ile başlamaz ve başlamamalıdır.
# Tarayıcı Koala backend'ine hiç doğrudan konuşmaz; her istek Next.js
# sunucusundan geçer, dolayısıyla tarayıcının API adresini bilmesine de gerek
# yoktur. Değerler src/env.ts içinde zod ile açılışta doğrulanır: eksik ya da
# bozuk bir değişkenle uygulama yarım açılmaz, hiç açılmaz.

# Koala backend'inin kökü. Backend'de servlet context-path yoktur; uçlar kökten
# servis edilir (/reference/job-categories gibi).
#   Yerel:  http://localhost:8080
#   Canlı:  https://api.iskoala.com
#
# Yerelde backend ayağa kaldırmadan çalışmak isterseniz staging'e de
# bakabilirsiniz: https://api-staging.iskoala.com
KOALA_API_BASE_URL=http://localhost:8080

# Tek bir backend çağrısı için üst sınır (milisaniye). Opsiyoneldir; varsayılan 15000.
# KOALA_API_TIMEOUT_MS=15000

# --- Sonraki dilimler ---
# Kimlik doğrulama (is-koala/koala-admin#4) kendi değişkenlerini buraya
# ekleyecek; panelin dış adresi için AUTH_URL bunlardan biri. Bu dilimde
# kullanılmadığı ve doğrulanmadığı için burada yalnız hatırlatma olarak duruyor.
