{
  "realm": "koala-staff",
  "enabled": true,
  "displayName": "Koala Staff — YEREL GELİŞTİRME KOPYASI",
  "displayNameHtml": "<b>Koala Staff</b> — yerel geliştirme kopyası",

  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,

  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "maxDeltaTimeSeconds": 43200,

  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": false,
  "editUsernameAllowed": false,

  "roles": {
    "realm": [
      {
        "name": "CATALOG_EDITOR",
        "description": "Yaprak rol: katalog düzenleme.",
        "composite": false
      },
      {
        "name": "SUPPORT_AGENT",
        "description": "Yaprak rol: destek.",
        "composite": false
      },
      {
        "name": "FINANCE_ANALYST",
        "description": "Yaprak rol: finans analizi.",
        "composite": false
      },
      {
        "name": "AUDITOR",
        "description": "Yaprak rol: denetim.",
        "composite": false
      },

      {
        "name": "MODERATOR",
        "description": "SUPPORT_AGENT'ı kapsar.",
        "composite": true,
        "composites": { "realm": ["SUPPORT_AGENT"] }
      },
      {
        "name": "DISPUTE_HANDLER",
        "description": "SUPPORT_AGENT'ı kapsar.",
        "composite": true,
        "composites": { "realm": ["SUPPORT_AGENT"] }
      },
      {
        "name": "COMPANY_APPROVER",
        "description": "SUPPORT_AGENT'ı kapsar.",
        "composite": true,
        "composites": { "realm": ["SUPPORT_AGENT"] }
      },
      {
        "name": "TRUST_LEAD",
        "description": "MODERATOR + DISPUTE_HANDLER — hiyerarşinin ağaç değil DAG olmasının sebebi.",
        "composite": true,
        "composites": { "realm": ["MODERATOR", "DISPUTE_HANDLER"] }
      },
      {
        "name": "FINANCE_OFFICER",
        "description": "FINANCE_ANALYST'i kapsar. Trust dalını kapsamaz — görev ayrılığı.",
        "composite": true,
        "composites": { "realm": ["FINANCE_ANALYST"] }
      },
      {
        "name": "OWNER",
        "description": "Hepsini kapsar. Trust ve finans dallarını birden kapsayan tek rol.",
        "composite": true,
        "composites": {
          "realm": [
            "CATALOG_EDITOR",
            "SUPPORT_AGENT",
            "FINANCE_ANALYST",
            "AUDITOR",
            "MODERATOR",
            "DISPUTE_HANDLER",
            "COMPANY_APPROVER",
            "TRUST_LEAD",
            "FINANCE_OFFICER"
          ]
        }
      }
    ]
  },

  "clients": [
    {
      "clientId": "koala-admin-web",
      "name": "Koala Yönetim Paneli",
      "enabled": true,
      "protocol": "openid-connect",

      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local-dev-only-koala-admin-web-secret",

      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,

      "redirectUris": ["http://localhost:3000/api/auth/callback/keycloak"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*",
        "pkce.code.challenge.method": "S256"
      },
      "webOrigins": ["http://localhost:3000"],

      "fullScopeAllowed": true,
      "frontchannelLogout": true,

      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "koala-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "",
            "included.custom.audience": "koala-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "owner@koala.local",
      "email": "owner@koala.local",
      "emailVerified": true,
      "firstName": "Yerel",
      "lastName": "Owner",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "owner-local-dev",
          "temporary": false
        }
      ],
      "realmRoles": ["OWNER"]
    }
  ]
}
